// ============================================================
// ADAPTER used by docExtractor.js fallback path
// ============================================================
export async function extractWithTess(file) {
    const FALLBACK_TAG = '[tess:fallback]';
    const flog  = (...a) => console.log(FALLBACK_TAG, ...a);
    const fwarn = (...a) => console.warn(FALLBACK_TAG, ...a);
    const ferr  = (...a) => console.error(FALLBACK_TAG, ...a);

    flog('╔══════════════════════════════════════════╗');
    flog('║  extractWithTess() — FALLBACK ENGAGED    ║');
    flog('╚══════════════════════════════════════════╝');
    flog('file:', file?.name, '|', file?.type, '|', file?.size, 'bytes');

    const t0 = performance.now();

    try {
        flog('▶ calling teSsAna.analyzeDocument(file)…');
        const analysis = await teSsAna.analyzeDocument(file);

        const ms = (performance.now() - t0).toFixed(1);
        flog(`✅ analyzeDocument returned in ${ms}ms`);
        flog('   analysis:', analysis);

        const fields = analysis?.extractedData || {};
        flog('   fields extracted:', Object.keys(fields).length, fields);

        const result = {
            fields,
            raw: null,
            source: 'tess',
            documentType: analysis?.documentType || 'General Document',
            language:     analysis?.language || 'unknown',
            summary:      analysis?.summary || '',
            confidence:   analysis?.confidence ?? 0.3,
        };

        flog('✅ extractWithTess returning:', result);
        return result;
    } catch (e) {
        const ms = (performance.now() - t0).toFixed(1);
        ferr(`❌ extractWithTess FAILED after ${ms}ms`);
        ferr('   message:', e.message);
        ferr('   name   :', e.name);
        ferr('   stack  :', e.stack);
        ferr('   full   :', e);
        throw e;
    }
}