// ============================================================
// API ACTION EXECUTOR - WITH LOGGING
// ============================================================

export async function executeApiAction(action, context = {}) {
  log(`📌 EXECUTING ACTION: ${action.id || 'unknown'}`, 'INFO');
  log(`📦 Context:`, 'DEBUG');
  console.log(context);
  
  const startTime = Date.now();
  
  try {
    let result;
    let scriptName = action.id || 'unknown';
    
    switch (action.id) {
      case 'login_to_iftms':
        const username = context.phoneNumber || context.operator?.phoneNumber || '';
        const password = context.password || context.operator?.password || '';
        log(`🔐 Login with username: ${username}`, 'INFO');
        result = await runCapgoScript(
          getLoginScript(username, password),
          true, // hidden
          'Login Script'
        );
        break;
        
      case 'register_vehicle':
        log(`🚗 Registering vehicle: ${context.plateNumber || 'unknown'}`, 'INFO');
        result = await runCapgoScript(
          getRegisterVehicleScript(context),
          true,
          'Vehicle Registration'
        );
        break;
        
      case 'register_driver':
        log(`👤 Registering driver: ${context.driverName || 'unknown'}`, 'INFO');
        result = await runCapgoScript(
          getRegisterDriverScript(context),
          true,
          'Driver Registration'
        );
        break;
        
      case 'sync_to_ifmts':
        log(`🔄 Syncing data...`, 'INFO');
        result = await runCapgoScript(
          getSyncScript(context.operator || {}, context.vehicles || [], context.drivers || []),
          true,
          'Sync Script'
        );
        break;
        
      case 'decode_vin':
        const vinNumber = context.vinNumber || context.userInput || '';
        log(`🔍 Decoding VIN: ${vinNumber}`, 'INFO');
        result = await runCapgoScript(
          getVINDecodeScript(vinNumber),
          true,
          'VIN Decode'
        );
        break;
        
      default:
        log(`⚠️ Unknown action: ${action.id}, using generic handler`, 'WARN');
        if (action.endpoint) {
          log(`🌐 Fetching endpoint: ${action.endpoint}`, 'INFO');
          const response = await fetch(action.endpoint, {
            method: action.method || 'POST',
            headers: {
              'Content-Type': 'application/json',
              ...(action.headers || {})
            },
            body: JSON.stringify(resolveParams(action.data || context, context))
          });
          
          result = await response.json();
          log(`✅ API call completed`, 'SUCCESS');
        } else {
          result = { success: false, error: `Unknown action: ${action.id}` };
          log(`❌ Unknown action: ${action.id}`, 'ERROR');
        }
    }
    
    const duration = Date.now() - startTime;
    
    apiLogs.push({
      timestamp: new Date().toISOString(),
      action: action.id || action.type,
      duration,
      success: result.success !== false,
      result: result
    });
    
    log(`✅ ACTION COMPLETED in ${duration}ms`, 'SUCCESS');
    log(`📊 Result:`, 'DEBUG');
    console.log(result);
    
    return result;
    
  } catch (error) {
    const duration = Date.now() - startTime;
    
    log(`💥 ACTION FAILED in ${duration}ms`, 'ERROR');
    log(`❌ Error: ${error.message}`, 'ERROR');
    log(`Stack: ${error.stack}`, 'ERROR');
    
    apiLogs.push({
      timestamp: new Date().toISOString(),
      action: action.id || action.type,
      duration,
      success: false,
      error: error.message,
      stack: error.stack
    });
    
    return {
      success: false,
      error: error.message,
      stack: error.stack
    };
  }
}

// ============================================================
// VISIBLE BROWSER WITH USER INTERACTION
// ============================================================

export async function openVisibleBrowser(url, script = null) {
  log(`🌐 Opening visible browser to: ${url}`, 'INFO');
  
  try {
    const { id } = await InAppBrowser.openWebView({
      url: url,
      hidden: false,
      options: {
        showToolbar: true,
        showURL: true,
        enableDebug: true
      }
    });
    
    log(`✅ Browser opened with ID: ${id}`, 'SUCCESS');
    activeBrowsers[id] = { id, timestamp: Date.now(), type: 'visible' };
    
    if (script) {
      log('🔄 Executing script in visible browser...', 'DEBUG');
      const result = await InAppBrowser.executeScript({
        id,
        js: script
      });
      log('✅ Script executed', 'SUCCESS');
      return result;
    }
    
    return { success: true, browserId: id };
  } catch (error) {
    log(`❌ Failed to open browser: ${error.message}`, 'ERROR');
    return { success: false, error: error.message };
  }
}

// ============================================================
// BROWSER MANAGEMENT
// ============================================================

export async function closeAllBrowsers() {
  log(`🧹 Closing all browsers (${Object.keys(activeBrowsers).length} active)`, 'INFO');
  
  let closed = 0;
  for (const id of Object.keys(activeBrowsers)) {
    try {
      await InAppBrowser.closeWebView({ id });
      closed++;
      log(`✅ Closed browser: ${id}`, 'SUCCESS');
    } catch (e) {
      log(`❌ Failed to close browser ${id}: ${e.message}`, 'ERROR');
    }
  }
  activeBrowsers = {};
  log(`🧹 Closed ${closed} browsers`, 'SUCCESS');
}

// ============================================================
// EXECUTE STEP API ACTIONS
// ============================================================

export async function executeStepApiActions(step, context = {}) {
  log(`📌 EXECUTING STEP ACTIONS for: ${step.id || 'unknown'}`, 'INFO');
  
  if (!step.apiActions || step.apiActions.length === 0) {
    log('⚠️ No API actions to execute', 'WARN');
    return { success: true, continue: true };
  }
  
  log(`📋 Found ${step.apiActions.length} actions to execute`, 'INFO');
  
  const results = [];
  
  for (const action of step.apiActions) {
    log(`🔄 Processing action: ${action.id || action.type}`, 'INFO');
    
    if (action.condition && !evaluateCondition(action.condition, context)) {
      log(`⏭️ Skipping action (condition not met): ${action.id}`, 'WARN');
      continue;
    }
    
    const result = await executeApiAction(action, context);
    results.push(result);
    
    if (!result.success) {
      log(`❌ Action failed: ${action.id}`, 'ERROR');
      return {
        success: false,
        error: result.error,
        message: getLocalizedMessage(action.onFailure?.message) || result.error,
        action: action,
        results
      };
    }
    
    if (action.onSuccess?.nextStep) {
      log(`🔄 Moving to next step: ${action.onSuccess.nextStep}`, 'INFO');
      return {
        success: true,
        continue: false,
        nextStep: action.onSuccess.nextStep,
        message: getLocalizedMessage(action.onSuccess.message),
        result,
        results
      };
    }
    
    if (action.onSuccess?.continue === false) {
      log(`⏹️ Stopping execution`, 'INFO');
      return {
        success: true,
        continue: false,
        message: getLocalizedMessage(action.onSuccess?.message),
        result,
        results
      };
    }
  }
  
  log(`✅ All ${step.apiActions.length} actions completed successfully`, 'SUCCESS');
  
  return {
    success: true,
    continue: true,
    results,
    nextStep: step.onValid?.nextStep || null
  };
}

// ============================================================
// EXECUTE FIELD API ACTIONS
// ============================================================

export async function executeFieldApiActions(field, context = {}) {
  log(`📌 EXECUTING FIELD ACTIONS for: ${field.id || 'unknown'}`, 'INFO');
  
  if (!field.apiActions || field.apiActions.length === 0) {
    log('⚠️ No API actions to execute', 'WARN');
    return { success: true, continue: true };
  }
  
  log(`📋 Found ${field.apiActions.length} actions to execute`, 'INFO');
  const results = [];
  
  for (const action of field.apiActions) {
    log(`🔄 Processing action: ${action.id || action.type}`, 'INFO');
    const result = await executeApiAction(action, context);
    results.push(result);
    
    if (!result.success) {
      log(`❌ Action failed: ${action.id}`, 'ERROR');
      return {
        success: false,
        error: result.error,
        message: getLocalizedMessage(action.onFailure?.message) || result.error,
        action: action,
        results
      };
    }
    
    if (action.onSuccess?.message) {
      log(`✅ Action completed with message: ${action.onSuccess.message}`, 'SUCCESS');
      return {
        success: true,
        continue: false,
        message: getLocalizedMessage(action.onSuccess.message),
        result,
        results
      };
    }
  }
  
  log(`✅ All ${field.apiActions.length} actions completed successfully`, 'SUCCESS');
  
  return {
    success: true,
    continue: true,
    results
  };
}

// ============================================================
// HELPER FUNCTIONS
// ============================================================

function resolveParams(params, context) {
  if (!params) return {};
  
  const result = {};
  
  for (const [key, value] of Object.entries(params)) {
    if (typeof value === 'string' && value.includes('{{')) {
      const matches = value.match(/\{\{([^}]+)\}\}/g);
      if (matches) {
        let resolved = value;
        for (const match of matches) {
          const path = match.slice(2, -2).trim();
          const resolvedValue = getValueByPath(context, path);
          resolved = resolved.replace(match, resolvedValue !== undefined ? String(resolvedValue) : '');
        }
        result[key] = resolved;
      } else {
        result[key] = value;
      }
    } else if (typeof value === 'object' && value !== null && !Array.isArray(value)) {
      result[key] = resolveParams(value, context);
    } else {
      result[key] = value;
    }
  }
  
  return result;
}

function getValueByPath(obj, path) {
  if (!obj || !path) return undefined;
  
  const parts = path.split('.');
  let current = obj;
  
  for (const part of parts) {
    if (current === undefined || current === null) return undefined;
    if (part === 'collected_data') return obj.collectedData || {};
    if (part === 'operator') return obj.operator || {};
    if (part === 'vehicles') return obj.vehicles || [];
    if (part === 'drivers') return obj.drivers || [];
    if (part === 'user_input') return obj.userInput || '';
    if (part === 'current_item') return obj.currentItem || {};
    
    current = current[part];
  }
  
  return current;
}

function evaluateCondition(condition, context) {
  if (!condition) return true;
  
  try {
    const resolved = resolveParams({ value: condition }, context);
    const expr = resolved.value || condition;
    return Function('"use strict"; return (' + expr + ')')();
  } catch {
    return true;
  }
}

function getLocalizedMessage(message) {
  if (!message) return '';
  if (typeof message === 'string') return message;
  
  const lang = localStorage.getItem('agig-language') || 'en';
  if (typeof message === 'object') {
    return message[lang] || message.en || '';
  }
  
  return message;
}

