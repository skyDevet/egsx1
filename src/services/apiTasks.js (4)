// ============================================================
// apiTasks.js - Capgo InAppBrowser Action Handler
// WITH FULL CONSOLE LOGGING
// ============================================================

import { InAppBrowser } from '@capgo/capacitor-inappbrowser';

let apiLogs = [];
let activeBrowsers = {};
let debugMode = true; // SET TO FALSE TO HIDE LOGS

// ============================================================
// CONSOLE HELPER
// ============================================================

function log(message, type = 'INFO') {
  if (!debugMode) return;
  
  const timestamp = new Date().toISOString();
  const prefix = `[${timestamp}] 🟢 CAPGO`;
  
  switch(type) {
    case 'ERROR':
      console.error(`${prefix} ❌ ${message}`);
      break;
    case 'WARN':
      console.warn(`${prefix} ⚠️ ${message}`);
      break;
    case 'SUCCESS':
      console.log(`${prefix} ✅ ${message}`);
      break;
    case 'DEBUG':
      console.log(`${prefix} 🔍 ${message}`);
      break;
    default:
      console.log(`${prefix} ${message}`);
  }
}

// ============================================================
// CONFIGURATION
// ============================================================

export function getApiLogs() {
  return apiLogs;
}

export function clearApiLogs() {
  apiLogs = [];
}

export function setDebugMode(enabled) {
  debugMode = enabled;
  log(`Debug mode set to: ${enabled}`, 'INFO');
}

// ============================================================
// CAPGO INAPPBROWSER CORE - WITH FULL LOGGING
// ============================================================

async function runCapgoScript(code, hidden = true, scriptName = 'Anonymous') {
  log(`🚀 STARTING SCRIPT: ${scriptName}`, 'INFO');
  log(`📝 Hidden mode: ${hidden}`, 'DEBUG');
  log(`📏 Script length: ${code.length} characters`, 'DEBUG');
  
  let browserId = null;
  const startTime = Date.now();
  
  try {
    // Open headless WebView
    log('🔄 Opening WebView...', 'DEBUG');
    
    const { id } = await InAppBrowser.openWebView({
      url: 'about:blank',
      hidden: hidden
    });
    
    browserId = id;
    activeBrowsers[id] = { id, timestamp: Date.now(), scriptName };
    log(`✅ WebView opened with ID: ${id}`, 'SUCCESS');
    
    // Execute the script with logging wrapper
    log('🔄 Executing script...', 'DEBUG');
    
    const wrappedCode = `
      (async function() {
        const startTime = Date.now();
        const logs = [];
        const errors = [];
        
        // Override console methods to capture everything
        const originalLog = console.log;
        const originalError = console.error;
        const originalWarn = console.warn;
        const originalInfo = console.info;
        const originalDebug = console.debug;
        
        console.log = function(...args) {
          const msg = args.join(' ');
          logs.push('📝 LOG: ' + msg);
          originalLog.apply(console, ['[CAPGO-WEBVIEW]', ...args]);
        };
        
        console.error = function(...args) {
          const msg = args.join(' ');
          logs.push('❌ ERROR: ' + msg);
          errors.push(msg);
          originalError.apply(console, ['[CAPGO-WEBVIEW]', ...args]);
        };
        
        console.warn = function(...args) {
          const msg = args.join(' ');
          logs.push('⚠️ WARN: ' + msg);
          originalWarn.apply(console, ['[CAPGO-WEBVIEW]', ...args]);
        };
        
        console.info = function(...args) {
          const msg = args.join(' ');
          logs.push('ℹ️ INFO: ' + msg);
          originalInfo.apply(console, ['[CAPGO-WEBVIEW]', ...args]);
        };
        
        console.debug = function(...args) {
          const msg = args.join(' ');
          logs.push('🐛 DEBUG: ' + msg);
          originalDebug.apply(console, ['[CAPGO-WEBVIEW]', ...args]);
        };
        
        logs.push('🚀 Script execution started');
        logs.push('📍 Timestamp: ' + new Date().toISOString());
        
        try {
          // Execute the actual script
          ${code}
          
          const duration = Date.now() - startTime;
          logs.push('✅ Script completed successfully in ' + duration + 'ms');
          
          return {
            success: true,
            logs: logs,
            errors: errors,
            duration: duration,
            timestamp: new Date().toISOString()
          };
        } catch (error) {
          logs.push('💥 Script error: ' + error.message);
          logs.push('Stack trace: ' + error.stack);
          errors.push(error.message);
          
          return {
            success: false,
            error: error.message,
            stack: error.stack,
            logs: logs,
            errors: errors,
            duration: Date.now() - startTime,
            timestamp: new Date().toISOString()
          };
        }
      })();
    `;
    
    const result = await InAppBrowser.executeScript({
      id,
      js: wrappedCode
    });
    
    // Log everything from the WebView
    log('📊 SCRIPT RESULT:', 'INFO');
    console.log('==================================================');
    console.log('🔍 FULL SCRIPT OUTPUT:');
    console.log('--------------------------------------------------');
    console.log('Success:', result.success);
    console.log('Duration:', result.duration, 'ms');
    console.log('Errors:', result.errors || 'None');
    console.log('--------------------------------------------------');
    
    if (result.logs && result.logs.length > 0) {
      console.log('📋 WEBVIEW CONSOLE LOGS:');
      console.log('--------------------------------------------------');
      result.logs.forEach((logLine, index) => {
        console.log(`  ${index + 1}. ${logLine}`);
      });
      console.log('--------------------------------------------------');
      console.log(`📊 Total logs: ${result.logs.length}`);
    } else {
      console.log('⚠️ No logs captured from WebView');
    }
    
    if (result.error) {
      console.log('❌ ERROR DETAILS:');
      console.log('--------------------------------------------------');
      console.log('Error:', result.error);
      console.log('Stack:', result.stack || 'No stack trace');
      console.log('--------------------------------------------------');
    }
    
    console.log('==================================================');
    
    // Close the browser
    log('🔄 Closing browser...', 'DEBUG');
    await InAppBrowser.closeWebView({ id });
    delete activeBrowsers[id];
    
    const totalDuration = Date.now() - startTime;
    log(`✅ SCRIPT COMPLETED in ${totalDuration}ms`, 'SUCCESS');
    
    // Add to API logs
    apiLogs.push({
      timestamp: new Date().toISOString(),
      scriptName: scriptName,
      duration: totalDuration,
      success: result.success !== false,
      logs: result.logs || [],
      error: result.error || null
    });
    
    return result;
    
  } catch (error) {
    log(`💥 FATAL ERROR: ${error.message}`, 'ERROR');
    log(`Stack: ${error.stack}`, 'ERROR');
    
    if (browserId) {
      try {
        await InAppBrowser.closeWebView({ id: browserId });
        delete activeBrowsers[browserId];
        log('🧹 Cleaned up browser instance', 'DEBUG');
      } catch (e) {
        log(`Failed to clean up: ${e.message}`, 'WARN');
      }
    }
    
    const totalDuration = Date.now() - startTime;
    
    apiLogs.push({
      timestamp: new Date().toISOString(),
      scriptName: scriptName,
      duration: totalDuration,
      success: false,
      error: error.message,
      stack: error.stack
    });
    
    return {
      success: false,
      error: error.message,
      stack: error.stack,
      duration: totalDuration,
      logs: [`Fatal error: ${error.message}`]
    };
  }
}

